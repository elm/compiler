cabal-version: 3.6
build-type: Simple

name: elm
version: 0.19.4

homepage: https://elm-lang.org
author: Evan Czaplicki
maintainer: info@elm-lang.org
copyright: Copyright (c) 2011-present, Evan Czaplicki
license: BSD-3-Clause
license-file: LICENSE


executable elm
    ghc-options: -O2 -rtsopts -threaded "-with-rtsopts=-N -A128m" -Wall -Werror
        -- add -eventlog for (elm make src/Main.elm +RTS -l; threadscope elm.eventlog)
        -- https://www.oreilly.com/library/view/parallel-and-concurrent/9781449335939/

    build-depends:
        ansi-terminal,
        ansi-wl-pprint < 1,
        array,
        base,
        binary,
        bytestring,
        containers,
        crypton < 2.0,
        directory,
        edit-distance,
        filelock,
        filepath,
        ghc-prim,
        haskeline,
        HTTP,
        http-client,
        http-client-tls,
        http-types,
        language-glsl,
        mtl,
        network,
        parsec,
        process,
        scientific,
        SHA,
        snap-core,
        snap-server,
        template-haskell,
        time,
        unordered-containers,
        utf8-string,
        zip-archive

    hs-source-dirs:
        compiler/src
        builder/src
        src/utils
        terminal/impl
        terminal/src

    main-is:
        Main.hs

    other-modules:
        Bump
        Develop
        Diff
        Init
        Install
        Make
        Publish
        Repl

        -- terminal args
        Terminal
        Terminal.Chomp
        Terminal.Error
        Terminal.Helpers
        Terminal.Internal

        -- from terminal/
        Develop.Generate.Help
        Develop.Generate.Index
        Develop.StaticFiles
        Develop.StaticFiles_TH

        -- from builder/
        Build
        Deps.Bump
        Deps.Diff
        Deps.Registry
        Deps.Solver
        Deps.Website
        File
        Generate
        Http
        Reporting
        Reporting.Exit
        Reporting.Exit.Help
        Reporting.Task
        Root

        -- Elm things
        Elm.Outline
        Elm.Details
        --
        Elm.Compiler.Imports
        Elm.Compiler.Type
        Elm.Compiler.Type.Extract
        Elm.Constraint
        Elm.Docs
        Elm.Float
        Elm.Interface
        Elm.Kernel
        Elm.Licenses
        Elm.Magnitude
        Elm.ModuleName
        Elm.Package
        Elm.String
        Elm.Version

        -- data structures
        Data.Bag
        Data.Dups
        Data.Index
        Data.NonEmptyList
        Data.NonEmptyMap
        Data.OneOrMore
        Data.Utf8

        -- json
        Json.Decode
        Json.Encode
        Json.String

        -- from compiler/
        AST.Source
        AST.Canonical
        AST.Typed
        AST.Optimized
        AST.Prim.Fields
        AST.Prim.Mode
        AST.Prim.Module
        AST.Prim.Name
        AST.Prim.Operator
        AST.Prim.Shader
        AST.Prim.Tag
        AST.Prim.TypeIndex
        AST.Prim.TypeMask
        AST.Prim.TypeName
        AST.Prim.TypeVar
        AST.Prim.Variable
        Canonicalize.Decl
        Canonicalize.Effects
        Canonicalize.Environment
        Canonicalize.Environment.Foreign
        Canonicalize.Expression
        Canonicalize.Module
        Canonicalize.Pattern
        Canonicalize.Type
        Canonicalize.TypeDecl
        Compile
        Generate.Html
        Generate.JavaScript
        Generate.JavaScript.Builder
        Generate.JavaScript.Expression
        Generate.JavaScript.Functions
        Generate.JavaScript.Name
        Generate.Mode
        Nitpick.Debug
        Nitpick.PatternMatches
        Nitpick.Utils
        Optimize.Case
        Optimize.DecisionTree
        Optimize.Expression
        Optimize.Module
        Optimize.Names
        Optimize.Port
        Parse.Declaration
        Parse.Expression
        Parse.Keyword
        Parse.Keyword_TH
        Parse.Module
        Parse.Number
        Parse.Pattern
        Parse.Shader
        Parse.Space
        Parse.String
        Parse.Symbol
        Parse.Type
        Parse.Variable
        Parse.Primitives
        Reporting.Ambiguous
        Reporting.Annotation
        Reporting.Doc
        Reporting.Error
        Reporting.Error.Canonicalize
        Reporting.Error.Docs
        Reporting.Error.Import
        Reporting.Error.Json
        Reporting.Error.Main
        Reporting.Error.Nitpick
        Reporting.Error.Pattern
        Reporting.Error.Syntax
        Reporting.Error.Type
        Reporting.Render.Code
        Reporting.Render.Type
        Reporting.Report
        Reporting.Suggest
        Reporting.Warning
        Type.Check
        Type.Constrain.Expression
